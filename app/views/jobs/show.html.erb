<div class="max-w-3xl mx-auto py-12 px-4">
  <%# Navigation Header %>
  <div class="mb-6">
    <%= link_to "← Back to Jobs", jobs_path, class: "text-sm font-medium text-blue-600 hover:text-blue-800 transition" %>
  </div>

  <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
    <%# Card Header %>
    <div class="px-8 py-6 border-b border-slate-100 bg-slate-50/50 flex justify-between items-center">
      <div>
        <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight"><%= @job.title %></h1>
        <p class="text-lg text-slate-500 font-medium mt-1"><%= @job.company %></p>
      </div>
      <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold bg-blue-100 text-blue-700">
        <%= @job.status %>
      </span>
    </div>

    <%# Card Body %>
    <div class="px-8 py-8 space-y-8">
      <div>
        <h3 class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-3">Job Notes</h3>
        <div class="bg-slate-50 rounded-xl p-6 border border-slate-100">
          <p class="text-slate-700 leading-relaxed whitespace-pre-wrap"><%= @job.notes.presence || "No notes provided for this application." %></p>
        </div>
      </div>
    </div>

    <%# Action Footer %>
    <div class="px-8 py-5 bg-slate-50 border-t border-slate-100 flex justify-between items-center">
      <div class="flex gap-4">
        <%= link_to "Edit Job", edit_job_path(@job), class: "text-sm font-semibold bg-white border border-slate-300 px-4 py-2 rounded-lg hover:bg-slate-50 transition shadow-sm" if defined?(edit_job_path) %>
      </div>

      <%= button_to "Delete Application", job_path(@job), method: :delete,
                    form: { data: { turbo_confirm: "Are you sure you want to remove this job?" } },
                    class: "text-sm font-semibold text-red-600 hover:text-red-700" %>
    </div>
  </div>
</div>
