<h1>All Jobs</h1>

<% @jobs.each do |job| %>
    <h2><%= link_to job.title, job_path(job) %></h2>
    <p><%= job.company %></p>
    <p><%= job.status %></p>
    <p><%= job.notes %></p>

    <%= button_to "Delete Job",  job_path(job), method: :delete, confirm: "Are you sure?"  %>
<% end %>

<%= link_to "Add New Job", new_job_path %>