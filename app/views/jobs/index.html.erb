<div class="max-w-6xl mx-auto py-10 px-4">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-4xl font-extrabold text-slate-900 tracking-tight">Job Applications</h1>
    <%= link_to "Add New Job", new_job_path, class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-6 rounded-lg transition duration-200 shadow-md" %>
  </div>

  <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% @jobs.each do |job| %>
      <div class="bg-white border border-slate-200 p-6 rounded-xl shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
        <div>
          <div class="flex justify-between items-start mb-4">
            <h2 class="text-xl font-bold text-slate-800 hover:text-blue-600 truncate">
              <%= link_to job.title, job_path(job) %>
            </h2>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
              <%= job.status %>
            </span>
          </div>

          <p class="text-sm font-semibold text-slate-500 uppercase tracking-wider mb-2"><%= job.company %></p>
          <p class="text-slate-600 text-sm line-clamp-3 mb-6 italic">"<%= job.notes %>"</p>
        </div>

        <div class="flex items-center justify-between pt-4 border-t border-slate-100">
          <%= link_to "View Details", job_path(job), class: "text-blue-600 font-semibold text-sm hover:underline" %>
          <%= button_to "Delete", job_path(job), method: :delete,
                        form: { data: { turbo_confirm: "Are you sure?" } },
                        class: "text-red-500 hover:text-red-700 text-sm font-medium" %>
        </div>
      </div>
    <% end %>
  </section>
</div>
