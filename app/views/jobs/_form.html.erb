<%= form_with model: @job do |form| %>
    <p>
        <%= form.label :title %><br>
        <%= form.text_field :title %>
    </p>
    <p>
        <%= form.label :company %><br>
        <%= form.text_field :company %>
    </p>
    <p>
        <%= form.label :status %><br>
        <%= form.select :status, Job.statuses.keys %>
    </p>
    <p>
        <%= form.label :notes %><br>
        <%= form.text_area :notes %>
    </p>
    <p>
        <%= form.submit %>
    </p>

    <% if @job.errors.any? %>
    <div>
        <h3><%= pluralize(@job.errors.count, "error") %> prevented saving:</h3>
        <ul>
        <% @job.errors.full_messages.each do |message| %>
            <li><%= message %></li>
        <% end %>
        </ul>
    </div>
    <% end %>
<% end %>